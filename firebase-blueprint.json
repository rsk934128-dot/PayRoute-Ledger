{
  "entities": {
    "wallets": {
      "title": "Wallets",
      "description": "Stores user, business, and system wallets",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "accountNo": { "type": "string" },
        "ownerName": { "type": "string" },
        "ownerType": { "type": "string", "enum": ["user", "business", "merchant", "system"] },
        "currency": { "type": "string" },
        "balance": { "type": "number" },
        "lockedBalance": { "type": "number" },
        "overdraftLimit": { "type": "number" },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "FROZEN"] },
        "lastUpdated": { "type": "string" }
      },
      "required": ["id", "accountNo", "ownerName", "balance", "status"]
    },
    "paymentRails": {
      "title": "Payment Rails",
      "description": "Payment network status and configuration",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string", "enum": ["OPERATIONAL", "DEGRADED", "OUTAGE"] },
        "successRate": { "type": "number" },
        "latencyMs": { "type": "number" },
        "feePercentage": { "type": "number" },
        "flatFee": { "type": "number" },
        "isBackupAvailable": { "type": "boolean" },
        "backupRail": { "type": "string" }
      },
      "required": ["id", "name", "status"]
    },
    "transactions": {
      "title": "Transactions",
      "description": "Financial transaction records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "senderWalletId": { "type": "string" },
        "senderName": { "type": "string" },
        "receiverWalletId": { "type": "string" },
        "receiverName": { "type": "string" },
        "amount": { "type": "number" },
        "fee": { "type": "number" },
        "currency": { "type": "string" },
        "status": { "type": "string" },
        "requestedRail": { "type": "string" },
        "executedRail": { "type": "string" },
        "wasRerouted": { "type": "boolean" },
        "reference": { "type": "string" },
        "timestamp": { "type": "string" },
        "idempotencyKey": { "type": "string" },
        "hash": { "type": "string" }
      },
      "required": ["id", "senderWalletId", "receiverWalletId", "amount", "status", "timestamp"]
    },
    "ledgerEntries": {
      "title": "Ledger Entries",
      "description": "Double-entry accounting records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transactionId": { "type": "string" },
        "walletId": { "type": "string" },
        "walletOwner": { "type": "string" },
        "type": { "type": "string", "enum": ["DEBIT", "CREDIT"] },
        "amount": { "type": "number" },
        "balanceAfter": { "type": "number" },
        "currency": { "type": "string" },
        "timestamp": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "transactionId", "walletId", "type", "amount", "balanceAfter"]
    },
    "webhookEvents": {
      "title": "Webhook Events",
      "description": "Merchant notification events and delivery status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transactionId": { "type": "string" },
        "merchantId": { "type": "string" },
        "eventType": { "type": "string" },
        "status": { "type": "string", "enum": ["DELIVERED", "FAILED", "PENDING"] },
        "statusCode": { "type": "number" },
        "timestamp": { "type": "string" },
        "endpointUrl": { "type": "string" },
        "attemptCount": { "type": "number" },
        "failureReason": { "type": "string" }
      },
      "required": ["id", "transactionId", "eventType", "status"]
    },
    "anomalyAlerts": {
      "title": "Anomaly Alerts",
      "description": "AI-detected security and fraud anomalies",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "transactionId": { "type": "string" },
        "severity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "score": { "type": "number" },
        "reason": { "type": "string" },
        "recommendation": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "transactionId", "severity", "score"]
    },
    "gmailLogs": {
      "title": "Gmail Logs",
      "description": "Log of emails sent via Gmail API",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientEmail": { "type": "string" },
        "subject": { "type": "string" },
        "status": { "type": "string", "enum": ["SENT", "FAILED"] },
        "sentAt": { "type": "string" }
      },
      "required": ["id", "recipientEmail", "status", "sentAt"]
    },
    "smsLogs": {
      "title": "SMS Logs",
      "description": "Log of SMS sent via Twilio API",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientPhone": { "type": "string" },
        "message": { "type": "string" },
        "status": { "type": "string", "enum": ["SENT", "FAILED"] },
        "sentAt": { "type": "string" },
        "sid": { "type": "string" }
      },
      "required": ["id", "recipientPhone", "status", "sentAt"]
    }
  },
  "firestore": {
    "wallets/{walletId}": {
      "schema": "wallets",
      "description": "User and system wallets"
    },
    "paymentRails/{railId}": {
      "schema": "paymentRails",
      "description": "Config and status of payment networks"
    },
    "transactions/{txId}": {
      "schema": "transactions",
      "description": "Ledger transactions"
    },
    "ledgerEntries/{entryId}": {
      "schema": "ledgerEntries",
      "description": "Double-entry bookkeeping records"
    },
    "webhookEvents/{eventId}": {
      "schema": "webhookEvents",
      "description": "Outbound webhook tracking"
    },
    "anomalyAlerts/{alertId}": {
      "schema": "anomalyAlerts",
      "description": "AI security alerts"
    },
    "gmailLogs/{logId}": {
      "schema": "gmailLogs",
      "description": "Gmail notification history"
    },
    "smsLogs/{logId}": {
      "schema": "smsLogs",
      "description": "SMS notification history"
    }
  }
}
