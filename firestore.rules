rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /billPayments/{id} {
      allow read, write: if true;
    }
    match /recurringTransfers/{id} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
